---
/**
 * Product card for grids and hub pages.
 *
 * A 'coming-soon' product renders a waitlist link rather than an affiliate
 * CTA, and never shows a price. That gating lives here rather than at each
 * call site so a new page cannot accidentally publish a placeholder number.
 */
import { formatPrice, PRICES_CONFIRMED } from '../lib/site.js';
import { CATEGORIES } from '../lib/products.js';

const { product, href } = Astro.props;
const cat = CATEGORIES[product.category];
const soon = product.status === 'coming-soon';
// Unreleased products live at /soon/<slug> so they do not occupy the URL the
// product will own once it is actually purchasable. See src/pages/soon/.
const url = href || (soon ? `/soon/${product.slug}` : `${cat.href}/${product.slug}`);
---
<article class="pcard">
  <a class="pcard-media" href={url} tabindex="-1" aria-hidden="true">
    <img
      src={product.image}
      alt=""
      width="800" height="800"
      loading="lazy" decoding="async"
    />
  </a>
  <div class="pcard-body">
    <p class="pcard-meta">
      <span class:list={['badge', soon ? 'badge-soon' : 'badge-live']}>
        {soon ? 'Coming soon' : 'Available'}
      </span>
    </p>
    <h3 class="pcard-title"><a href={url}>{product.name}</a></h3>
    <p class="pcard-summary">{product.summary}</p>
    <p class="pcard-price">
      {soon ? 'Not yet released' : formatPrice(product)}
      {!soon && !PRICES_CONFIRMED && (
        <span class="pcard-note">— pricing confirmed at launch</span>
      )}
    </p>
  </div>
</article>

<style>
  .pcard {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: box-shadow 0.15s ease, transform 0.15s ease;
    height: 100%;
  }
  .pcard:hover { box-shadow: var(--shadow-lift); transform: translateY(-2px); }
  .pcard-media { display: block; background: var(--mist); }
  .pcard-media img { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; }
  .pcard-body { padding: var(--s4); display: flex; flex-direction: column; flex: 1; }
  .pcard-meta { margin: 0 0 var(--s3); }
  .pcard-title { font-size: 1.0625rem; margin: 0 0 var(--s2); }
  .pcard-title a { color: var(--ink); text-decoration: none; }
  .pcard-title a:hover { color: var(--azure-dark); text-decoration: underline; }
  .pcard-summary { font-size: 0.9375rem; color: var(--slate); margin: 0 0 var(--s4); flex: 1; }
  .pcard-price { margin: 0; font-weight: 700; font-size: 0.9375rem; }
  .pcard-note { font-weight: 400; color: var(--slate); font-size: 0.8125rem; }
</style>
