---
/**
 * The three-step activation, as a numbered list rather than three loose divs.
 * It IS an ordered sequence, and an <ol> tells a screen reader that; a grid of
 * headings does not.
 */
const steps = [
  {
    n: '1',
    title: 'Wet it',
    body: 'Any water will do — a tap, a bottle, a water butt. Cold water starts colder but does not cool for longer; the evaporation does the work either way.',
  },
  {
    n: '2',
    title: 'Wring it out',
    body: 'Hard. Water sitting deep in the fabric does no cooling and only makes the towel heavy and drippy. You want it damp, not wet.',
  },
  {
    n: '3',
    title: 'Snap it',
    body: 'Several sharp snaps through the air. This forces air through the weave and pulls water back to the surface, where it can actually evaporate.',
  },
];
---
<ol class="steps">
  {steps.map((s) => (
    <li class="step">
      <span class="step-n" aria-hidden="true">{s.n}</span>
      <h3>{s.title}</h3>
      <p>{s.body}</p>
    </li>
  ))}
</ol>

<style>
  .steps {
    list-style: none;
    margin: 0 0 var(--s5);
    padding: 0;
    display: grid;
    gap: var(--s4);
    grid-template-columns: 1fr;
    counter-reset: step;
  }
  @media (min-width: 46em) { .steps { grid-template-columns: repeat(3, 1fr); } }

  .step {
    background: #fff;
    border: 1px solid var(--line);
    border-top: 4px solid var(--zest);
    border-radius: var(--radius);
    padding: var(--s5);
    box-shadow: var(--shadow);
  }
  .step-n {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px; height: 38px;
    border-radius: 50%;
    background: var(--azure);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.125rem;
    margin-bottom: var(--s3);
  }
  .step h3 { margin: 0 0 var(--s2); font-size: 1.125rem; }
  .step p { margin: 0; color: var(--slate); font-size: 0.9375rem; }
</style>
